# Upstash Redis (from Vercel Marketplace or upstash.com)
# The local root .env must point to this same database for the MT5 outbound mailbox.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# Server-only credentials
DASHBOARD_API_KEY=replace-with-a-long-random-value
OAK_CTRADER_VAULT_KEY=replace-with-an-independent-high-entropy-vault-key
# H1 cloud scanner config (enabled + Telegram destination) is AES-GCM encrypted
# into Upstash with OAK_CTRADER_VAULT_KEY during one-time cutover setup.
# Scheduled GitHub calls authenticate with short-lived OIDC; no GitHub scanner secret is required.
GEMINI_API_KEY=replace-with-google-ai-studio-key
VIP_TOKEN=replace-with-weekday-vip-token

# Optional AI models and server-side quota guards
FACTCHECK_MODEL=gemini-3.5-flash-lite
FACTCHECK_PER_MINUTE_LIMIT=5
FACTCHECK_DAILY_LIMIT=200
FACTCHECK_MEDIA_MODEL=gemini-3.6-flash
FACTCHECK_MEDIA_PER_MINUTE_LIMIT=3
FACTCHECK_MEDIA_DAILY_LIMIT=80
# Optional live media-forensics sidecar. Both are required to activate C2PA + specialist detector evidence.
FACTCHECK_FORENSICS_URL=https://media-forensics.example.internal
FACTCHECK_FORENSICS_TOKEN=replace-with-long-service-token
TAROT_MODEL=gemini-3.5-flash-lite
TAROT_PER_MINUTE_LIMIT=3
TAROT_DAILY_LIMIT=120

# Optional: API URL for local development
# NEXT_PUBLIC_API_URL=http://localhost:3000
