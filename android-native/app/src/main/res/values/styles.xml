<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OAKGatekeeper" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.OAKGatekeeper.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/oak_launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/oak_launcher_foreground_inset</item>
        <item name="postSplashScreenTheme">@style/Theme.OAKGatekeeper</item>
    </style>
</resources>
