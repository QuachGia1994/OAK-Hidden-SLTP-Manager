# Fact-Check Worker - Upstash Redis
# Get these from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# Optional: Google Custom Search JSON API for web results
# Set GOOGLE_CSE_API_KEY and GOOGLE_CSE_ID to enable Google web search hits.
# GOOGLE_CSE_API_KEY=AIza...
# GOOGLE_CSE_ID=xxxxxxxxxxxxxxxxx

# Optional third engine: GitHub Models judges only Google/DDG evidence and never invents sources.
# Requires a GitHub PAT with `models:read` permission. Public preview + rate limits apply.
# FACTCHECK_GITHUB_TOKEN=github_pat_...
# Or reuse an existing GITHUB_TOKEN / GH_TOKEN if your desktop worker inherits it.
# FACTCHECK_AI_MODEL=openai/gpt-4.1-mini
# FACTCHECK_AI_API_URL=https://models.github.ai/inference/chat/completions
#
# Optional fallback if you still want direct OpenAI:
# FACTCHECK_AI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# VN30 H=4 advisory scanner - SSI FastConnect market data only.
# Never add OTP, trading private keys, or real secrets to this file.
# SSI_CLIENT_ID=oak-stock-scanner
# SSI_API_KEY=your_market_data_api_key
# SSI_API_SECRET=your_market_data_api_secret
# STOCK_DEPLOYABLE_CAPITAL=90000000
# STOCK_HURDLE_BPS=0
