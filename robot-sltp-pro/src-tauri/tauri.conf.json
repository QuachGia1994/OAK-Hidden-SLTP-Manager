{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ROBOT SLTP Pro",
  "version": "4.1.0",
  "identifier": "com.qkp.robotsltppro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "ROBOT SLTP Pro",
      "width": 1536,
      "height": 940,
      "minWidth": 1180,
      "minHeight": 760,
      "resizable": true,
      "fullscreen": false,
      "decorations": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "shortDescription": "OAK Gatekeeper desktop trading command workstation",
    "longDescription": "ROBOT SLTP Pro v4 desktop command workstation for MT5 profile monitoring, automated SL/TP, Telegram order control, Netting scheduling and Engine 5 Pattern Matrix.",
    "category": "Finance"
  }
}
