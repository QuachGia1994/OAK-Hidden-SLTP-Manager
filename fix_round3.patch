+            print(
+                f"[WARN] Profile '{profile_name}' not found in profiles.json. "
+                f"Falling back to first available profile."
+            )
+            return list(profiles_data.keys())[0] if profiles_data else ""
+        return profile_name
+
+    if profiles_data:
+        return list(profiles_data.keys())[0]
+
+    return ""
