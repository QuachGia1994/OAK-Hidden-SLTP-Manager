{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OAK Manager",
  "version": "0.1.0",
  "identifier": "com.oak.sltp.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OAK Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/oak-core"],
    "resources": [
      "resources/oak-data/profiles.example.json",
      "resources/oak-data/settings.example.json",
      "resources/oak-data/config.example.toml"
    ],
    "icon": []
  }
}
